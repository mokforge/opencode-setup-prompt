<ac:structured-macro ac:name="info">
  <ac:rich-text-body>
    <p>All requests require a bearer token.</p>
  </ac:rich-text-body>
</ac:structured-macro>
<h1>Store API overview</h1>
<p>The Store API accepts orders and publishes an event after payment confirmation.</p>
<h2>Order flow</h2>
<p>
  <ac:image ac:alt="Order flow">
    <ri:attachment ri:filename="orders-flow.png"/>
  </ac:image>
</p>
<table>
  <tbody>
    <tr>
      <th>Field</th>
      <th>Type</th>
      <th>Required</th>
      <th>Description</th>
    </tr>
    <tr>
      <td><code>customer_id</code></td>
      <td>string</td>
      <td>yes</td>
      <td>Customer identifier</td>
    </tr>
    <tr>
      <td><code>items</code></td>
      <td>array</td>
      <td>yes</td>
      <td>At least one item</td>
    </tr>
    <tr>
      <td><code>coupon</code></td>
      <td>string</td>
      <td>no</td>
      <td>Optional coupon code</td>
    </tr>
  </tbody>
</table>
<ac:structured-macro ac:name="code">
  <ac:parameter ac:name="language">http</ac:parameter>
  <ac:plain-text-body><![CDATA[POST /orders
Authorization: Bearer <token>]]></ac:plain-text-body>
</ac:structured-macro>
<ac:structured-macro ac:name="expand">
  <ac:parameter ac:name="title">Error response</ac:parameter>
  <ac:rich-text-body>
    <ac:structured-macro ac:name="code">
      <ac:parameter ac:name="language">json</ac:parameter>
      <ac:plain-text-body><![CDATA[{"error": "PAYMENT_DECLINED"}]]></ac:plain-text-body>
    </ac:structured-macro>
  </ac:rich-text-body>
</ac:structured-macro>
<ac:structured-macro ac:name="toc">
  <ac:parameter ac:name="maxLevel">3</ac:parameter>
</ac:structured-macro>
